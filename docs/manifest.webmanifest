{
  "id": "./",
  "name": "Bergamot",
  "short_name": "Bergamot",
  "description": "Mind for shift workers: a calm journal with prompts that know your shifts, notes with [[links]] and checklists, and the tasks and habits that move your goals. The mind app of the citrus family.",
  "start_url": "./index.html",
  "scope": "./",
  "display": "standalone",
  "display_override": [
    "standalone",
    "minimal-ui"
  ],
  "orientation": "any",
  "lang": "en",
  "dir": "ltr",
  "categories": [
    "lifestyle",
    "productivity",
    "health"
  ],
  "background_color": "#0b1716",
  "theme_color": "#0b1716",
  "shortcuts": [
    {
      "name": "Write in the journal",
      "short_name": "Write",
      "url": "./index.html?do=write",
      "icons": [
        {
          "src": "icons/icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "New note",
      "short_name": "Note",
      "url": "./index.html?do=note",
      "icons": [
        {
          "src": "icons/icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "New task",
      "short_name": "Task",
      "url": "./index.html?do=task",
      "icons": [
        {
          "src": "icons/icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Habits",
      "short_name": "Habits",
      "url": "./index.html?do=habits",
      "icons": [
        {
          "src": "icons/icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    }
  ],
  "icons": [
    {
      "src": "icons/icon.svg",
      "sizes": "any",
